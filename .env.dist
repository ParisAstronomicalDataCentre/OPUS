# OPUS settings (template)
#
# Generate a .env file from this template, with random values for the secrets:
#     python generate_env.py > .env
# or convert an existing settings_local.py (deprecated):
#     python generate_env.py --from settings_local.py > .env
#
# Keep .env private: no git tracking, no public read access.
# All the settings defined in opus_config/server.py and opus_config/client.py can be
# set here, prefixed with OPUS_ (defaults are given below as comments). Dicts and lists
# are given as JSON. Environment variables have priority over this file.


### Secrets (random values, keep them secret)

# Admin token, used by the client to access the server
OPUS_ADMIN_TOKEN=
# Tokens for special users, used internally
OPUS_JOB_EVENT_TOKEN=
OPUS_MAINTENANCE_TOKEN=
# Key used by Flask to sign the session cookies of the client (changing it logs out all users)
OPUS_SECRET_KEY=
# Salt used to hash the passwords of the client users
# WARNING: changing it invalidates all the existing passwords
OPUS_SECURITY_PASSWORD_SALT=
# Passwords of the users created at first start of the client (to be changed after install)
OPUS_ADMIN_DEFAULT_PW=
OPUS_TESTUSER_DEFAULT_PW=
# PostgreSQL password (if OPUS_STORAGE_TYPE=PostgreSQL)
#OPUS_PGSQL_PASSWORD=opus


### URLs and paths

# URL of the server, and of the client (e.g. behind nginx or Apache)
#OPUS_BASE_URL=http://localhost:8082
#OPUS_UWS_CLIENT_ENDPOINT=http://localhost:8080
#OPUS_UWS_SERVER_ENDPOINT=/uws
#OPUS_BASE_IP=127.0.0.1
# Directory where app data is stored (writable by the user running OPUS), relative to
# the OPUS directory if not absolute, e.g. /var/opt/opus
#OPUS_VAR_PATH=local_var


### Admin and mail

#OPUS_ADMIN_NAME=opus-admin
#OPUS_ADMIN_EMAIL=admin@opus
#OPUS_MAIL_SERVER=smtp.
#OPUS_MAIL_PORT=25
#OPUS_SENDER_EMAIL=no_reply@opus


### Client

#OPUS_CLIENT_TITLE=OPUS
#OPUS_HOME_CONTENT=
# OpenID Connect Identity Providers, e.g.
# OPUS_OIDC_IDPS='[{"title": "OIDC login", "description": "", "url_logo": "/static/images/openid.jpg", "url": "https://<openid-server>/.well-known/openid-configuration", "client_id": "", "client_secret": "", "scope": "openid email profile"}]'
#OPUS_OIDC_IDPS=[]


### Server access rules

#OPUS_ALLOW_ANONYMOUS=true
#OPUS_CHECK_PERMISSIONS=false
#OPUS_CHECK_OWNER=false
# max active jobs per user, 0 for no restriction
#OPUS_NJOBS_MAX=0
# If a user has an APP_TOKEN, access to jobs will be added automatically
#OPUS_APP_TOKENS='{"<token>": {"name": "<name>", "active": true, "jobs": ["<jobname1>"]}}'
# IPs allowed to report job events, and trusted clients (default: localhost and BASE_IP)
#OPUS_JOB_SERVERS='{"::1": "localhost", "127.0.0.1": "localhost"}'
#OPUS_TRUSTED_CLIENTS='{"::1": "localhost", "127.0.0.1": "localhost"}'


### Jobs

#OPUS_DESTRUCTION_INTERVAL=30
#OPUS_EXECUTION_DURATION_DEF=120
#OPUS_EXECUTION_DURATION_MAX=3600
#OPUS_WAIT_TIME_MAX=600
#OPUS_JOB_ID_LENGTH=6
# Generators of identifiers and tokens, as import strings (see opus_config/generators.py)
#OPUS_JOB_ID_GEN=opus_config.generators:job_id


### Storage and manager

# SQLite or PostgreSQL
#OPUS_STORAGE_TYPE=SQLite
#OPUS_PGSQL_HOST=localhost
#OPUS_PGSQL_PORT=5432
#OPUS_PGSQL_DATABASE=opus
#OPUS_PGSQL_USER=opus
# Local or SLURM (see the SLURM_* settings in opus_config/server.py)
#OPUS_MANAGER=Local
