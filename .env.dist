# OPUS settings (template)
#
# Generate a .env file from this template, with random values for the secrets:
#     python generate_env.py > .env
# or convert an existing settings_local.py (deprecated):
#     python generate_env.py --from settings_local.py > .env
#
# Keep .env private: no git tracking, no public read access.
# The main settings are listed here, all the settings are described in docs/settings.md (defined in
# opus_config/server.py and opus_config/client.py), prefixed with OPUS_.
# - A commented line gives the default value of the setting: uncomment it to change the value.
# - The comment at the end of a line gives the possible values (a | b), the unit, or the default value when
#   the line is an example (no comment at the end of an empty value: it would be read as the value).
# - Dicts and lists are given as JSON, and may span several lines between single quotes.
# Environment variables have priority over this file.


### Secrets (random values, keep them secret)

# Admin token, used by the client to access the server
OPUS_ADMIN_TOKEN=
# Tokens for special users, used internally
OPUS_JOB_EVENT_TOKEN=
OPUS_MAINTENANCE_TOKEN=
# Key used by Flask to sign the session cookies of the client (changing it logs out all users)
OPUS_SECRET_KEY=
# Salt used to hash the passwords of the client users
# WARNING: changing it invalidates all the existing passwords
OPUS_SECURITY_PASSWORD_SALT=
# Passwords of the users created at first start of the client (to be changed after install)
OPUS_ADMIN_DEFAULT_PW=
OPUS_TESTUSER_DEFAULT_PW=
# Also check the OPUS_PGSQL_PASSWORD below, if OPUS_STORAGE_TYPE=PostgreSQL


### URLs and paths

# URL of the server, and of the client (e.g. behind nginx or Apache)
OPUS_BASE_IP=127.0.0.1  # default 127.0.0.1
OPUS_BASE_URL=http://localhost:8082
OPUS_UWS_CLIENT_ENDPOINT=http://localhost:8080
#OPUS_UWS_SERVER_ENDPOINT=/uws
# UWS server used by the client
#OPUS_UWS_SERVER_URL=OPUS_BASE_URL  # default: OPUS_BASE_URL
# Number of threads handling the requests in parallel (server and client)
#OPUS_WSGI_THREADS=10  # 1 or more, default 10
# Directory where app data is stored (writable by the user running OPUS), relative to
# the OPUS directory if not absolute, e.g. /var/opt/opus
OPUS_VAR_PATH=local_var  # default local_var


### Admin and mail

#OPUS_ADMIN_NAME=opus-admin  # default opus-admin
#OPUS_ADMIN_EMAIL=admin@opus
#OPUS_MAIL_SERVER=smtp.
#OPUS_MAIL_PORT=25  # default 25
#OPUS_MAIL_USE_SSL=false  # true | false, default false
#OPUS_MAIL_USE_TLS=false  # true | false, default false
#OPUS_SENDER_EMAIL=no_reply@opus


### Client

#OPUS_CLIENT_TITLE=OPUS  # default OPUS
# Content of the home page (HTML accepted), e.g. "<h3>OPUS</h3><p>Welcome!</p>"
#OPUS_HOME_CONTENT=
# Users can create their own account on the registration page (<client>/accounts/register)
#OPUS_SECURITY_REGISTERABLE=false  # true | false
# OpenID Connect Identity Providers (client and server), list of providers
#OPUS_OIDC_IDPS='[
#    {
#        "title": "OIDC login",
#        "description": "",
#        "url_logo": "/static/images/openid.jpg",
#        "url": "https://<openid-server>/.well-known/openid-configuration",
#        "client_id": "",
#        "client_secret": "",
#        "scope": "openid email profile",
#        "audience": "",
#        "logout_url": ""
#    }
#]'  # example, default: []
# Authentication of the client on the server: Basic (name and OPUS token), OIDC (access token
# of the users signed in with an Identity Provider, and their OPUS token), or None (no credentials sent:
# to use for an external UWS service, e.g. a TAP server, see the Admin guide)
#OPUS_UWS_AUTH=Basic  # Basic | OIDC | None, default Basic


### Server access rules

# Requests without authentication allowed (user anonymous)
#OPUS_ALLOW_ANONYMOUS=false  # true | false, default false
# Rights to create/edit a job checked (roles of the user)
#OPUS_CHECK_PERMISSIONS=true  # true | false, default true
# Only the owner can access their jobs and files
#OPUS_CHECK_OWNER=true  # true | false, default true
# Maximum number of active jobs per user
#OPUS_NJOBS_MAX=0  # 0 for no restriction, default 0
# If a user has an APP_TOKEN, access rights to jobs will be added automatically
#OPUS_APP_TOKENS='{
#    "<token>": {
#        "name": "<name>",
#        "active": true,
#        "jobs": [
#            "<jobname1>",
#            "<jobname2>"
#        ]
#    }
#}'  # example, default: {}
# IPs allowed to report job events: {"<IP>": "<name>"}, an IP or the start of an IP followed by *
# for a set of IPs (e.g. "192.168.1.*")
#OPUS_JOB_SERVERS='{
#    "::1": "localhost",
#    "127.0.0.1": "localhost"
#}'  # default: localhost and OPUS_BASE_IP
# Trusted clients (access to /db and /jdl, e.g. validation), same format as OPUS_JOB_SERVERS
#OPUS_TRUSTED_CLIENTS='{
#    "::1": "localhost",
#    "127.0.0.1": "localhost"
#}'  # default: localhost and OPUS_BASE_IP


### Jobs

#OPUS_DESTRUCTION_INTERVAL=30  # days, default 30
#OPUS_EXECUTION_DURATION_DEF=120  # seconds, default 120, 0 for unlimited
#OPUS_EXECUTION_DURATION_MAX=0  # seconds, default 0, 0 for unlimited, caps the duration of the jobs
#OPUS_WAIT_TIME_MAX=600  # seconds, default 600
#OPUS_JOB_ID_LENGTH=6  # 36 at most, default 6
# ARCHIVED phase (UWS 1.1) for the jobs after their destruction time
#OPUS_USE_ARCHIVED_PHASE=true  # true | false, default true
# Provenance files added to the results of the jobs
#OPUS_GENERATE_PROV=true  # true | false, default true
# Algorithm of the hash of the result files (SHA)
#OPUS_SHA_ALGO=1  # 1 | 224 | 256 | 384 | 512, default 1
# Generators of identifiers and tokens, as import strings "module:function" (see opus_config/generators.py)
#OPUS_JOB_ID_GEN=opus_config.generators:job_id  # default opus_config.generators:job_id
#OPUS_ENTITY_ID_GEN=opus_config.generators:entity_id  # default opus_config.generators:entity_id
#OPUS_TOKEN_GEN=opus_config.generators:token  # default opus_config.generators:token


### Storage and manager

OPUS_STORAGE_TYPE=SQLite  # SQLite | PostgreSQL, default SQLite
#OPUS_PGSQL_HOST=localhost  # default localhost
#OPUS_PGSQL_PORT=5432  # default 5432
#OPUS_PGSQL_DATABASE=opus  # default opus
#OPUS_PGSQL_USER=opus  # default opus
# PGSQL password (keep it secret)
#OPUS_PGSQL_PASSWORD=
# Execution of the jobs: on the server (Local), or on a SLURM cluster (see the SLURM_* settings in docs/settings.md)
OPUS_MANAGER=Local  # Local | SLURM, default Local
# Working directory of the jobs (Local manager)
#OPUS_LOCAL_WORKDIR_PATH=/tmp  # default /tmp
