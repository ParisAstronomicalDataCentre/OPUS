# OPUS settings for Docker (template), read by docker-compose.yml (env_file: .env.docker)
#
# Generate .env.docker from this template, with random values for the secrets:
#     python generate_env.py --template .env.docker.dist > .env.docker
#
# Keep .env.docker private: no git tracking, no public read access.
# The settings for the container are set here, any other setting can be added (see .env.dist and docs/settings.md).
# - A line that is set gives the value for the container, the comment at the end of the line gives the default
#   value of OPUS (outside Docker) and the possible values (a | b).
# - A commented line gives the default value of the setting: uncomment it to change the value.
# - No comment at the end of an empty value: it would be read as the value.
# - Dicts and lists are given as JSON, and may span several lines between single quotes.


### Secrets (random values, keep them secret)

# Admin token, used by the client to access the server
OPUS_ADMIN_TOKEN=
# Tokens for special users, used internally
OPUS_JOB_EVENT_TOKEN=
OPUS_MAINTENANCE_TOKEN=
# Key used by Flask to sign the session cookies of the client (changing it logs out all users)
OPUS_SECRET_KEY=
# Salt used to hash the passwords of the client users
# WARNING: changing it invalidates all the existing passwords
OPUS_SECURITY_PASSWORD_SALT=
# Passwords of the users created at first start of the client (to be changed after install)
OPUS_ADMIN_DEFAULT_PW=
OPUS_TESTUSER_DEFAULT_PW=
# PostgreSQL password, also used by the db service of docker-compose.yml to create the database (with
# OPUS_PGSQL_USER and OPUS_PGSQL_DATABASE): changing it later requires changing it in the database too
OPUS_PGSQL_PASSWORD=


### Container settings

# URLs through nginx in the container, reachable from inside the container (jobs report
# their phase to BASE_URL) and from the browser
OPUS_BASE_URL=http://localhost/opus_server  # default: http://localhost:8082
OPUS_UWS_CLIENT_ENDPOINT=http://localhost/opus_client  # default: http://localhost:8080
# Data directory, stored in the opus_data volume
OPUS_VAR_PATH=/var/opt/opus  # default: local_var
# PostgreSQL database of the db service (created with OPUS_PGSQL_DATABASE, OPUS_PGSQL_USER and OPUS_PGSQL_PASSWORD)
OPUS_STORAGE_TYPE=PostgreSQL  # SQLite (default) | PostgreSQL
OPUS_PGSQL_HOST=db  # default: localhost
#OPUS_PGSQL_PORT=5432
#OPUS_PGSQL_DATABASE=opus
#OPUS_PGSQL_USER=opus


### Client

OPUS_CLIENT_TITLE="OPUS docker"  # default: OPUS
# Content of the home page (HTML accepted), e.g. "<h3>OPUS</h3><p>Welcome!</p>"
#OPUS_HOME_CONTENT=
# Users can create their own account on the registration page (<client>/accounts/register)
#OPUS_SECURITY_REGISTERABLE=false  # true | false
# Authentication of the client on the server (see .env.dist for OIDC and OPUS_OIDC_IDPS)
#OPUS_UWS_AUTH=Basic  # Basic | OIDC


### Server

#OPUS_ADMIN_NAME=opus-admin
#OPUS_ADMIN_EMAIL=admin@opus
# Access rules
#OPUS_ALLOW_ANONYMOUS=false  # true | false
#OPUS_CHECK_PERMISSIONS=true  # true | false
#OPUS_CHECK_OWNER=true  # true | false
# IPs allowed to report job events: {"<IP>": "<name>"}, an IP or the start of an IP followed by *
# for a set of IPs (e.g. "192.168.1.*"); the jobs of the container report from localhost
#OPUS_JOB_SERVERS='{
#    "::1": "localhost",
#    "127.0.0.1": "localhost"
#}'  # default: localhost and OPUS_BASE_IP
# Trusted clients (access to /db and /jdl, e.g. validation), same format as OPUS_JOB_SERVERS
#OPUS_TRUSTED_CLIENTS='{
#    "::1": "localhost",
#    "127.0.0.1": "localhost"
#}'  # default: localhost and OPUS_BASE_IP
# Number of threads handling the requests in parallel (server and client)
#OPUS_WSGI_THREADS=10  # 1 or more
# Shell of the batch script of the jobs: a login shell (-l) reads the profile of the user (e.g. PATH, conda,
# modules for the job scripts), use /bin/bash to start the jobs faster if the profile is not needed
#OPUS_BATCH_SHELL=/bin/bash -l  # /bin/bash -l | /bin/bash
