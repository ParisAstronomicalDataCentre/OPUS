FROM python:3.11-slim

# Installer Nginx et git
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl git graphviz nginx && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean

# Install uv
RUN pip install uv

RUN mkdir -p /opt/opus
WORKDIR /opt/opus

# Copy pyproject.toml and install les dependencies
COPY README.md ./
COPY pyproject.toml .
COPY uv.lock ./

# set environment with uv (dependencies only, from uv.lock, without dev tools)
RUN uv sync --locked --no-dev --no-install-project

# Create /opt/opus and copy uws_client/ and uws_server/
COPY favicon* ./
COPY .git ./.git
COPY opus_config/ /opt/opus/opus_config/
COPY uws_client/ /opt/opus/uws_client/
COPY uws_server/ /opt/opus/uws_server/
COPY uws_client/app.py ./app_client.py
COPY uws_server/app.py ./app_server.py
COPY generate_nginx_config.py ./generate_nginx_config.py

# Install the project itself now that the sources are copied
RUN uv sync --locked --no-dev

RUN mkdir -p /opt/opus/var/logs
RUN mkdir -p /var/opt/opus/logs

# Configuration de l'environnement
ENV PYTHONUNBUFFERED=1
ENV PATH="/usr/local/bin:$PATH"
# Settings are given as environment variables at runtime (env_file: .env.docker in
# docker-compose.yml), nginx.conf is generated from them at start (see start.sh)

# Exposition du port
EXPOSE 80

# Copy the script
COPY start.sh /start.sh
RUN chmod +x /start.sh

# Use the script in CMD
CMD ["/start.sh"]
